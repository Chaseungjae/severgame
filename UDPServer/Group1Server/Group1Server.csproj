<Project Sdk="Microsoft.NET.Sdk">

  <!--
    1조(반응·연타) 미니게임 전용 UDP 서버. 외부 NuGet 패키지 없음 (System.Net.Sockets.Socket 직접 사용).
    프로토콜 파일은 Unity 프로젝트의 것을 그대로 링크해서, 클라이언트와 서버가 같은 코드를 쓴다.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Group1Server</RootNamespace>
    <AssemblyName>Group1Server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\MiniGames\Group1_Reaction\Net\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
